#!/bin/sh
# Eddic's gate, run on every push. No GitHub Actions minutes are spent:
# ci.yml is a manual dispatch for the cross-OS matrix, nothing more.
#
# Activate once per clone:  uv run tools/dev_setup.py
#
# The gate itself lives in tools/gate.py so the hook, a maintainer
# checking a contributed branch, and the manual workflow all run exactly
# the same checks. Do not add checks here — add them there, or the gate
# stops meaning one thing.
#
# --no-verify overrides, and is between you and your conscience.

if command -v uv >/dev/null 2>&1; then
	uv run tools/gate.py || exit 1
else
	python3 tools/gate.py || exit 1
fi
